# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse (optional - tracing degrades gracefully if unset)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Model
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Demo mode — when set, /generate-campaign returns the committed fixture
# at examples/output_campaign.json instead of calling Claude. Useful for
# public deploys (no API key, instant response, zero cost).
# DEMO_MODE=1
